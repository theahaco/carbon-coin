---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Deliver units" active="deliver">
  <div class="page-head">
    <span class="eyebrow desk">Dealing Desk keys</span>
    <h1 class="h1-inner">Deliver units</h1>
    <p class="body-2">Sell today's issued units to the investors who ordered them, at the same NAV.</p>
  </div>

  <div id="page-error" class="status error" role="alert"></div>

  <section id="non-signer" class="card" hidden></section>

  <form id="deliver-form" class="stack" novalidate hidden>
    <div id="suspended" class="panel panel-alert" hidden>
      <span class="panel-label">Dealing suspended</span>
      <span>The Register has suspended dealing for the class. No deliveries are proposed until it lifts; the ledger would reject them.</span>
    </div>

    <div class="inventory-strip">
      <span class="inventory-label" id="inventory-label">Desk inventory</span>
      <span class="inventory-value" id="inventory-value">—</span>
    </div>

    <fieldset class="field" style="border:0;margin:0;padding:0">
      <legend class="field-label" style="padding:0;margin-bottom:6px">Investor</legend>
      <div class="picks" id="picks"></div>
      <label for="destination-input" class="small-muted sr-only" id="destination-label" style="margin-top:4px">Investor address</label>
      <input id="destination-input" class="input mono" name="destination" placeholder="r…" autocomplete="off" spellcheck="false" />
    </fieldset>

    <div id="destination-warning"></div>

    <div class="field-grid">
      <div class="field">
        <label for="units-input">Units</label>
        <input id="units-input" class="input" name="units" inputmode="decimal" placeholder="0.000" autocomplete="off" />
      </div>
      <div class="field">
        <label for="ref-input">Order reference (memo)</label>
        <input id="ref-input" class="input mono" name="ref" maxlength="64" autocomplete="off" spellcheck="false" />
      </div>
    </div>

    <div><button id="deliver-button" type="submit" class="btn btn-primary btn-lg">Sign delivery with passkey</button></div>
  </form>

  <section id="handoff" hidden></section>

  <section id="delivered" class="panel panel-success" hidden></section>

  <section id="not-completed" class="panel panel-alert" hidden></section>
</Layout>

<script>
  import { isValidClassicAddress } from 'xrpl'
  import { configRequiresAuth, loadPublicConfig, requireGovernance, requireIssuer, requireMptIssuanceId } from '../lib/config'
  import { onConnectionChange } from '../lib/connect'
  import { buildProposalPaymentTx } from '../lib/tx'
  import { signCeremonyPayload } from '../lib/ceremony'
  import { describeProposal } from '../lib/preview'
  import {
    checkTransfer,
    getIssuanceState,
    getIssuanceTransactions,
    getMptHolding,
    getMptHoldings,
    getOutgoingMptPayments,
    getPendingRequests,
    mintPeriodOf,
    watchProposal,
    type MptHolding,
    type MptPayment,
  } from '../lib/xrplClient'
  import { admissionsOf, investorPicks, listedAccounts, type Admission, type AdmissionRequest } from '../lib/admission'
  import { currentDealingDay, formatDealingDay, parseDealingMonth } from '../lib/dealing'
  import { orderRefOf } from '../lib/ledger'
  import { esc, shortAddress } from '../lib/format'
  import { seatOn, seatsOf, signerRole } from '../lib/role'
  import { formatUnits, parseUnits } from '../lib/units'
  import { nonSignerHtml, problemPanelHtml, readinessHtml, renderHandoff, sentenceHtml } from '../lib/ui'
  import type { ProblemStatus } from '../lib/outcome'

  const $ = (id: string) => document.getElementById(id)!
  const pageError = $('page-error')
  const form = $('deliver-form') as HTMLFormElement
  const destinationInput = $('destination-input') as HTMLInputElement
  const unitsInput = $('units-input') as HTMLInputElement
  const refInput = $('ref-input') as HTMLInputElement
  const deliverButton = $('deliver-button') as HTMLButtonElement
  const warning = $('destination-warning')

  let connectedAddress: string | undefined
  let stopWatching: (() => void) | undefined
  let inFlight = false
  /** Set while the readiness check says the ledger would reject this delivery; the sign button stays disabled. */
  let destinationBlocked = false
  /** The issuance is locked: dealing is suspended. */
  let suspended = false
  let checkSeq = 0

  async function main() {
    const config = await loadPublicConfig()
    const issuer = requireIssuer(config)
    const governance = requireGovernance(config)
    const mptIssuanceId = requireMptIssuanceId(config)
    const ticker = config.token.ticker
    const seats = seatsOf(config, 'desk')
    /** Accounts never listed as investors. */
    const exclude = [issuer.address, governance.address]

    let deliveries: MptPayment[] = []
    let admissions: Admission[] = []
    /** Accounts awaiting admission, which the Desk can't deliver to yet. */
    let awaiting: AdmissionRequest[] = []
    /** The listed accounts' holdings as last read, so the list shows where each stands now (a stop-transfer, say). */
    let holdings = new Map<string, MptHolding>()
    let dealingDay = currentDealingDay()
    /** Whether the issuance requires admission: the ledger's flags, else the published ones. Set before the first check. */
    let requireAuth = configRequiresAuth(config) ?? false
    const issuanceRead = getIssuanceState(mptIssuanceId)

    async function refreshInventory() {
      try {
        const desk = await getMptHolding(governance.address, mptIssuanceId)
        $('inventory-value').textContent = `${formatUnits(desk.balanceRaw)} ${ticker}`
        return desk.balanceRaw
      } catch {
        $('inventory-value').textContent = 'unavailable'
        return undefined
      }
    }

    function suggestOrderRef(): string {
      const prefix = `ORD-${dealingDay}-`
      const used = deliveries.map((p) => orderRefOf(p.memos) ?? '').filter((ref) => ref.startsWith(prefix)).length
      return `${prefix}${String(used + 1).padStart(3, '0')}`
    }

    /** Accounts on the register (or, on an open issuance, past delivery destinations), then those awaiting admission. */
    function renderPicks() {
      const known = investorPicks({ deliveries, admissions, pending: awaiting, exclude, requireAuth, holdings })
      $('picks').innerHTML = known
        .map(
          (pick) => `<label class="pick">
            <input type="radio" name="investor" value="${esc(pick.address)}" />
            <span class="pick-main"><span class="radio" aria-hidden="true"></span><span class="pick-addr" title="${esc(pick.address)}">${esc(shortAddress(pick.address))}</span></span>
            <span class="pick-status${pick.stopped ? ' is-stopped' : ''}">${esc(pick.status)}</span>
          </label>`,
        )
        .join('')
      const label = $('destination-label')
      label.textContent = known.length > 0 ? 'Or another investor address' : 'Investor address'
      label.classList.toggle('sr-only', known.length === 0)
      for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="investor"]')) {
        radio.addEventListener('change', () => {
          destinationInput.value = radio.value
          void checkDestination()
        })
      }
    }

    function setBlocked(blocked: boolean) {
      destinationBlocked = blocked
      deliverButton.disabled = destinationBlocked || suspended
    }

    /** The units typed so far as a raw amount, if they parse, so the check covers Desk inventory too. */
    function typedAmount(): string | undefined {
      try {
        return parseUnits(unitsInput.value)
      } catch {
        return undefined
      }
    }

    /**
     * Checks the destination (and, once units are entered, Desk inventory).
     * A blocked result disables the sign button: the ledger would reject the
     * delivery as things stand. A failed read leaves it enabled.
     */
    async function checkDestination() {
      const seq = ++checkSeq
      const destination = destinationInput.value.trim()
      warning.innerHTML = ''
      setBlocked(false)
      if (!destination) return
      if (!isValidClassicAddress(destination)) {
        warning.innerHTML = `<div class="status error">That isn't a valid XRPL address.</div>`
        return
      }
      try {
        const notice = await checkTransfer(governance.address, destination, mptIssuanceId, {
          source: 'The Dealing Desk',
          amount: typedAmount(),
          requireAuth,
        })
        if (seq !== checkSeq) return
        if (notice) {
          warning.innerHTML = readinessHtml(notice, '<div><button type="button" class="link-button" data-recheck>Check again</button></div>')
          warning.querySelector('[data-recheck]')?.addEventListener('click', () => void checkDestination())
          setBlocked(notice.blocked)
        }
      } catch {
        if (seq !== checkSeq) return
        warning.innerHTML = `<div class="status">Could not check the destination. Try again before signing.</div>`
      }
    }

    destinationInput.addEventListener('input', () => {
      // A new address needs a new check (on blur); drop the old result meanwhile.
      checkSeq++
      warning.innerHTML = ''
      setBlocked(false)
      const value = destinationInput.value.trim()
      for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="investor"]')) radio.checked = radio.value === value
    })
    destinationInput.addEventListener('blur', () => void checkDestination())
    unitsInput.addEventListener('change', () => {
      if (destinationInput.value.trim()) void checkDestination()
    })

    async function showDelivered(doneSentence: string) {
      stopWatching?.()
      $('handoff').hidden = true
      form.hidden = true
      const left = await refreshInventory()
      const panel = $('delivered')
      panel.innerHTML = `
        <span class="panel-label">${governance.quorum} of ${governance.quorum} keys · Delivered</span>
        <p class="result-sentence">${sentenceHtml(doneSentence)}</p>
        <div class="success-row"><span class="body-2">Desk inventory left today</span><span style="font-weight:500">${left === undefined ? 'unavailable' : `${esc(formatUnits(left))} ${esc(ticker)}`}</span></div>
        <div><button type="button" class="btn btn-primary" id="next-delivery">Next delivery</button></div>`
      panel.hidden = false
      $('next-delivery').addEventListener('click', () => {
        panel.hidden = true
        inFlight = false
        form.reset()
        warning.innerHTML = ''
        setBlocked(false)
        refInput.value = suggestOrderRef()
        form.hidden = !connectedAddress || !seatOn(config, 'desk', connectedAddress)
      })
    }

    /** The proposal settled without going through: drop the stale handoff card and say why. */
    function showNotCompleted(status: ProblemStatus, sentence: string) {
      stopWatching?.()
      $('handoff').hidden = true
      void refreshInventory()
      const panel = $('not-completed')
      panel.innerHTML = problemPanelHtml(status, sentence, '<button type="button" class="btn btn-primary" data-restart>Start a new delivery</button>')
      panel.hidden = false
      panel.querySelector('[data-restart]')?.addEventListener('click', () => {
        panel.hidden = true
        inFlight = false
        warning.innerHTML = ''
        form.hidden = !connectedAddress || !seatOn(config, 'desk', connectedAddress)
      })
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!connectedAddress) return
      pageError.textContent = ''
      const address = connectedAddress
      const destination = destinationInput.value.trim()
      const orderRef = refInput.value.trim()
      let amountRaw: string
      try {
        if (!isValidClassicAddress(destination)) throw new Error("Enter the investor's XRPL address.")
        if (destination === governance.address) throw new Error('The Dealing Desk cannot deliver to itself.')
        amountRaw = parseUnits(unitsInput.value)
        if (!orderRef) throw new Error('Enter the order reference. It goes on the ledger as the delivery memo.')
      } catch (err) {
        pageError.textContent = err instanceof Error ? err.message : String(err)
        return
      }
      await checkDestination()
      if (destinationBlocked || suspended) return
      deliverButton.disabled = true
      deliverButton.classList.add('is-waiting')
      deliverButton.textContent = 'Waiting for your passkey…'
      try {
        const tx = await buildProposalPaymentTx(governance.address, destination, mptIssuanceId, amountRaw, governance.quorum, {
          type: 'order-ref',
          data: orderRef,
        })
        const preview = describeProposal(tx, { ticker, mptIssuanceId, issuer: issuer.address, desk: governance.address })
        const outcome = await signCeremonyPayload(tx, address)
        if (outcome.status === 'error') throw new Error(outcome.message)
        inFlight = true
        const pending: MptPayment = { destination, amountRaw, memos: [{ type: 'order-ref', data: orderRef }] }
        deliveries = [pending, ...deliveries]
        if (outcome.status === 'submitted') {
          await showDelivered(preview.doneSentence)
          return
        }
        form.hidden = true
        const handoff = $('handoff')
        handoff.hidden = false
        await renderHandoff(handoff, {
          keySet: 'desk',
          seats,
          signed: new Set([address]),
          quorum: governance.quorum,
          relay: preview.sentence,
          shareUrl: outcome.shareUrl,
        })
        if (typeof tx.Sequence === 'number') {
          stopWatching = watchProposal(tx, (status) => {
            if (status.status === 'done') void showDelivered(preview.doneSentence)
            else {
              // It never delivered, so its order reference is free again.
              deliveries = deliveries.filter((payment) => payment !== pending)
              showNotCompleted(status, preview.sentence)
            }
          })
        }
      } catch (err) {
        pageError.textContent = err instanceof Error ? err.message : String(err)
      } finally {
        deliverButton.disabled = destinationBlocked || suspended
        deliverButton.classList.remove('is-waiting')
        deliverButton.textContent = 'Sign delivery with passkey'
      }
    })

    onConnectionChange((address) => {
      connectedAddress = address ?? undefined
      const seat = address ? seatOn(config, 'desk', address) : undefined
      const nonSigner = $('non-signer')
      if (!seat) {
        nonSigner.innerHTML = nonSignerHtml('desk', signerRole(config, address))
        nonSigner.hidden = false
        form.hidden = true
        return
      }
      nonSigner.hidden = true
      if (!inFlight) form.hidden = false
    })

    // A locked issuance means dealing is suspended: say so and don't propose. A failed read leaves it to the ledger.
    issuanceRead.then(
      (state) => {
        requireAuth = Boolean(state.flags.lsfMPTRequireAuth)
        suspended = Boolean(state.flags.lsfMPTLocked)
        $('suspended').hidden = !suspended
        setBlocked(destinationBlocked)
      },
      () => undefined,
    )

    refInput.value = suggestOrderRef()
    await refreshInventory()
    const [issues, desk, registerHistory] = await Promise.allSettled([
      getOutgoingMptPayments(issuer.address, mptIssuanceId),
      getOutgoingMptPayments(governance.address, mptIssuanceId),
      // Admissions and admission requests, both filed in the issuer's history.
      getIssuanceTransactions(issuer.address, mptIssuanceId),
    ])
    await issuanceRead.catch(() => undefined)
    if (registerHistory.status === 'fulfilled' && requireAuth) {
      admissions = admissionsOf(registerHistory.value, issuer.address)
      awaiting = await getPendingRequests(registerHistory.value, issuer.address, mptIssuanceId, [governance.address], 3).catch(() => [])
    }
    if (issues.status === 'fulfilled') {
      const days = issues.value
        .map((p) => parseDealingMonth(mintPeriodOf(p.memos) ?? ''))
        .filter((m) => m !== undefined)
        .map((m) => formatDealingDay(m!))
        .sort()
      const latest = days.at(-1)
      if (latest) {
        dealingDay = latest
        $('inventory-label').textContent = `Desk inventory · ${latest}`
      }
    }
    if (desk.status === 'fulfilled') {
      deliveries = [...desk.value].sort((a, b) => (b.ledgerIndex ?? 0) - (a.ledgerIndex ?? 0))
    }
    holdings = await getMptHoldings(listedAccounts({ deliveries, admissions, exclude, requireAuth }), mptIssuanceId)
    renderPicks()
    if (!refInput.value || refInput.value === `ORD-${currentDealingDay()}-001`) refInput.value = suggestOrderRef()
  }

  window.addEventListener('pagehide', () => stopWatching?.())

  main().catch((err) => {
    pageError.textContent = err instanceof Error ? err.message : String(err)
  })
</script>
