---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Sign a Proposal">
  <div class="inline-disclaimer">
    This page decodes and previews a pending mint or disbursement proposal. The decoded transaction fields (and then
    GhostSig's own passkey prompt) are what's actually reviewed and signed — never trust a link's surrounding text
    alone.
  </div>

  <div id="page-error"></div>

  <section class="card" id="paste-card">
    <h2>Open a proposal</h2>
    <p style="font-family: system-ui, sans-serif; font-size: 0.85rem;">
      Normally you'll arrive here via a link someone sent you. If a query string ever gets mangled by an email or
      chat client, paste the transaction blob or JSON below instead.
    </p>
    <div class="field">
      <label for="manual-input">Transaction blob (hex) or JSON</label>
      <input id="manual-input" placeholder="Paste here" />
    </div>
    <button id="manual-load" type="button">Load</button>
  </section>

  <section class="card" id="preview-card" style="display:none;">
    <h2>Proposal</h2>
    <div id="preview-body"></div>
    <div id="destination-warning" style="display:none; margin-top: 0.5rem;"></div>
  </section>

  <section class="card" id="sign-card" style="display:none;">
    <h2>Sign</h2>
    <button id="sign-button" type="button" style="display:none;">Sign</button>
    <div id="result-body" style="margin-top: 1rem;"></div>
  </section>
</Layout>

<script>
  import { decode } from 'xrpl'
  import { loadPublicConfig, isIssuerSigner, isGovernanceSigner } from '../lib/config'
  import { onConnectionChange } from '../lib/connect'
  import { signCeremonyPayload, buildHandoffMessage } from '../lib/ceremony'
  import { describePaymentTx } from '../lib/preview'
  import { destinationReadinessWarning } from '../lib/xrplClient'
  import { urlParamToBlob } from '../lib/blob'
  import QRCode from 'qrcode'

  function statusMessage(el: HTMLElement, kind: 'info' | 'success' | 'error', text: string) {
    el.innerHTML = `<div class="status-message ${kind}">${text}</div>`
  }

  const pasteCard = document.getElementById('paste-card')!
  const previewCard = document.getElementById('preview-card')!
  const previewBody = document.getElementById('preview-body')!
  const destinationWarning = document.getElementById('destination-warning')!
  const signCard = document.getElementById('sign-card')!
  const pageError = document.getElementById('page-error')!
  const signButton = document.getElementById('sign-button') as HTMLButtonElement
  const resultBody = document.getElementById('result-body')!
  const manualInput = document.getElementById('manual-input') as HTMLInputElement
  const manualLoad = document.getElementById('manual-load') as HTMLButtonElement

  let decodedTx: Record<string, unknown> | undefined
  let connectedAddress: string | undefined

  function parseInput(raw: string): Record<string, unknown> {
    const trimmed = raw.trim()
    if (trimmed.startsWith('{')) {
      return JSON.parse(trimmed) as Record<string, unknown>
    }
    return decode(trimmed) as unknown as Record<string, unknown>
  }

  function updateSignButtonVisibility() {
    signButton.style.display = decodedTx && connectedAddress ? 'inline-block' : 'none'
  }

  async function main() {
    const config = await loadPublicConfig()

    function loadTx(tx: Record<string, unknown>) {
      decodedTx = tx
      const preview = describePaymentTx(tx, config.token.ticker, config.issuer?.address, config.governance?.address)
      previewCard.style.display = 'block'
      previewBody.innerHTML = `
        <p><strong>${preview.summary}</strong></p>
        <p style="font-family: system-ui, sans-serif; font-size: 0.85rem;">
          From: <span class="mono address">${preview.account}</span><br/>
          To: <span class="mono address">${preview.destination}</span>
        </p>
      `
      pasteCard.style.display = 'none'
      signCard.style.display = 'block'
      updateSignButtonVisibility()
      destinationWarning.style.display = 'none'
      if (typeof tx.Account === 'string' && typeof tx.Destination === 'string' && config.mptIssuanceId) {
        destinationReadinessWarning(tx.Account, tx.Destination, config.mptIssuanceId)
          .then((warning) => {
            if (!warning) return
            statusMessage(destinationWarning, 'info', `\u26a0\ufe0f ${warning}`)
            destinationWarning.style.display = 'block'
          })
          .catch(() => {
            destinationWarning.textContent = 'Could not check token eligibility. Try again before signing.'
            destinationWarning.style.display = 'block'
          })
      }
    }

    const params = new URLSearchParams(window.location.search)
    const blobParam = params.get('b')
    if (blobParam) {
      try {
        const hexBlob = urlParamToBlob(blobParam)
        loadTx(parseInput(hexBlob))
      } catch (err) {
        statusMessage(previewBody, 'error', `Couldn't decode the transaction in this link: ${err instanceof Error ? err.message : String(err)}`)
        previewCard.style.display = 'block'
      }
    }

    manualLoad.addEventListener('click', () => {
      try {
        loadTx(parseInput(manualInput.value))
      } catch (err) {
        statusMessage(previewBody, 'error', `Couldn't parse that input: ${err instanceof Error ? err.message : String(err)}`)
        previewCard.style.display = 'block'
      }
    })

    onConnectionChange((address) => {
      connectedAddress = address ?? undefined
      if (address) {
        const recognized = isIssuerSigner(config, address) || isGovernanceSigner(config, address)
        if (!recognized) {
          statusMessage(
            pageError,
            'error',
            `Connected as <span class="mono address">${address}</span> — not on either published signer list. GhostSig will refuse to sign unless this address is on the account's live SignerList.`,
          )
        } else {
          pageError.innerHTML = ''
        }
      } else {
        pageError.innerHTML = ''
      }
      updateSignButtonVisibility()
    })

    signButton.addEventListener('click', async () => {
      if (!decodedTx || !connectedAddress) return
      signButton.disabled = true
      try {
        const preview = describePaymentTx(decodedTx, config.token.ticker, config.issuer?.address, config.governance?.address)
        const outcome = await signCeremonyPayload(decodedTx, connectedAddress)
        if (outcome.status === 'submitted') {
          statusMessage(resultBody, 'success', `Quorum met — submitted! (tx hash <span class="mono">${outcome.hash}</span>)`)
        } else if (outcome.status === 'handoff') {
          const message = buildHandoffMessage(preview, outcome.shareUrl)
          resultBody.innerHTML = `
            <div class="status-message info">${outcome.quorumStatus}</div>
            <p>Relay this link to the next signer:</p>
            <div class="field"><input readonly value="${message}" id="handoff-message" /></div>
            <button type="button" id="copy-handoff">Copy message</button>
            <div class="qr-wrapper"><img id="handoff-qr" alt="QR code linking to the sign page" /></div>
          `
          const qrImg = document.getElementById('handoff-qr') as HTMLImageElement
          qrImg.src = await QRCode.toDataURL(outcome.shareUrl)
          document.getElementById('copy-handoff')!.addEventListener('click', async () => {
            await navigator.clipboard.writeText(message)
          })
        } else {
          statusMessage(
            resultBody,
            'error',
            `${outcome.message}<br/><br/>If this proposal has already been fully signed and submitted, this error (an expired or already-used sequence number) is expected — check the issuer/governance account's recent transactions on the explorer.`,
          )
        }
      } catch (err) {
        statusMessage(resultBody, 'error', err instanceof Error ? err.message : String(err))
      } finally {
        signButton.disabled = false
      }
    })
  }

  main().catch((err) => {
    statusMessage(previewBody, 'error', err instanceof Error ? err.message : String(err))
    previewCard.style.display = 'block'
  })
</script>
