---
import '../styles/global.css'
import { withBase } from '../lib/paths'
import { brand } from '../brand'

export type NavId = 'overview' | 'dealing' | 'admit' | 'deliver' | 'sign' | 'controls' | 'about'

interface Props {
  title: string
  /** Which nav item is current. */
  active?: NavId
  /** The overview uses the wide, two-column page; everything else the 720px inner page. */
  wide?: boolean
}

const { title, active, wide = false } = Astro.props
// Crawlers need an absolute URL. The image carries the band, as the handoff asks.
const ogImage = Astro.site ? new URL(withBase('/og.png'), Astro.site).href : withBase('/og.png')

// Only routes backed by live ceremonies.
const nav: Array<{ id: NavId; label: string; href: string }> = [
  { id: 'overview', label: 'Overview', href: '/' },
  { id: 'dealing', label: 'Dealing day', href: '/propose-mint' },
  { id: 'admit', label: 'Admit investor', href: '/admit' },
  { id: 'deliver', label: 'Deliver units', href: '/propose-disbursement' },
  { id: 'sign', label: 'Co-sign', href: '/sign' },
  { id: 'controls', label: 'Controls', href: '/controls' },
  { id: 'about', label: 'About', href: '/about' },
]
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap"
    />
    <meta name="theme-color" content="#1F2A33" />
    <title>{title} · {brand.name} (testnet demo)</title>
    <meta name="description" content={brand.description} />
    <meta property="og:title" content={`${title} · ${brand.name} (testnet demo)`} />
    <meta property="og:description" content={`${brand.band}. ${brand.description}`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.name}, ${brand.subtitle}. ${brand.band}.`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="band" role="note">{brand.band}</div>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={withBase('/')}>
          <span class="wordmark-name">{brand.name}</span>
          <span class="wordmark-sub">{brand.subtitle}</span>
        </a>
        <div class="header-actions">
          <button id="header-connect" class="btn btn-secondary btn-sm" type="button" data-connect>Connect passkey</button>
          <span id="header-role" class="role-pill" hidden>
            <span id="header-role-dot" class="role-dot" data-role="visitor"></span>
            <span id="header-role-label">Visitor</span>
          </span>
          <button id="header-disconnect" class="link-button" type="button" hidden>Disconnect</button>
        </div>
      </div>
      <p id="connect-error" class="connect-error" role="alert" hidden></p>
      <nav class="site-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a
              class:list={['nav-link', { active: item.id === active }]}
              href={withBase(item.href)}
              aria-current={item.id === active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={[wide ? 'page-overview' : 'page-inner']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>{brand.footer}</span>
        <a href={withBase('/about')}>Redemption terms</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import { initConnectHeader } from '../lib/connect'
  initConnectHeader()

  // On a phone the nav scrolls sideways; bring the current page's item into view.
  const nav = document.querySelector<HTMLElement>('.site-nav')
  const current = nav?.querySelector<HTMLElement>('.nav-link.active')
  if (nav && current) {
    const overflow = current.getBoundingClientRect().right - nav.getBoundingClientRect().right
    if (overflow > 0) nav.scrollLeft += overflow + 10
  }
</script>
