{
  "name": "xrpl-token",
  "version": "0.1.0",
  "private": true,
  "description": "Simple XRPL fungible token (MPToken) with multisig-gated issuer and governance accounts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "devnet:up": "bash scripts/start.sh",
    "devnet:down": "bash scripts/stop.sh",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:test": "npm --prefix web run test",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit && npm run web:typecheck",
    "prototype:setup": "node scripts/setup-prototype.mjs",
    "cli:setup": "bash scripts/setup-cli.sh",
    "cli:lint": "shellcheck -x scripts/*.sh scripts/lib/*.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "xrpl": "file:.prototype/xrpl.js/packages/xrpl"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
