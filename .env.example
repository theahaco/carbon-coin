# Which network to use. "local" = stand-alone rippled node in Docker (colima/Docker Desktop).
# "testnet" = the public XRPL Testnet, funded via the public faucet.
# Switching networks is just this one value plus (optionally) XRPL_WS_URL below.
XRPL_NETWORK=local

# Optional: override the WebSocket URL for the selected network.
# Defaults: local -> ws://localhost:6006, testnet -> wss://s.altnet.rippletest.net:51233
# XRPL_WS_URL=

# Token identity, encoded into MPTokenMetadata (XLS-89) at issuance time.
# TOKEN_TICKER should be uppercase letters/digits, max 6 characters recommended.
TOKEN_TICKER=SMPL
TOKEN_NAME="Simple Governance Token"
TOKEN_DESCRIPTION="A simple annually-issued governance token on the XRP Ledger."
TOKEN_ICON_URL=https://example.org/token-icon.png
TOKEN_ASSET_CLASS=other
TOKEN_ASSET_SUBCLASS=other
TOKEN_ISSUER_NAME="Example Issuer Co."

# Issuance options, read by `setup:issuer`. Both are fixed when the MPT is
# created: changing them later needs a new issuance.
#
# MPT_REQUIRE_AUTH: "true" sets tfMPTRequireAuth, so a holder can only receive
# units after the issuer admits it (MPTokenAuthorize with Holder). It also
# changes the setup order: `setup:issuer` keeps the issuer's master key
# enabled, and `setup:governance` uses it to admit the governance account
# before disabling it. Default "false" (open holding).
# MPT_REQUIRE_AUTH=false
#
# TOKEN_ASSET_SCALE: the issuance's AssetScale, a whole number from 0 to 18.
# One displayed unit is 10^TOKEN_ASSET_SCALE on the ledger, e.g. 3 allows
# amounts to 0.001. Default 0 (whole units only).
# TOKEN_ASSET_SCALE=0

# Optional: comma-separated r-addresses to seed into the issuer/governance
# signer lists as-is (e.g. real GhostSig-controlled addresses), instead of
# the fully auto-generated placeholder wallets `setup-issuer`/
# `setup-governance` create by default. Any remaining signer slots are still
# auto-generated placeholders. Leave unset to keep today's fully-automatic
# local/CI behavior.
# ISSUER_SIGNER_ADDRESSES=
# GOVERNANCE_SIGNER_ADDRESSES=
