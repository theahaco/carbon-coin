# Which network to use. "local" = stand-alone rippled node in Docker (colima/Docker Desktop).
# "testnet" = the public XRPL Testnet, funded via the public faucet.
# Use separate TOKEN_STATE_FILE paths for separate deployments/networks.
XRPL_NETWORK=local

# The Rust CLI uses HTTP JSON-RPC, not a WebSocket endpoint.
# Defaults: local -> http://localhost:5005, testnet -> https://s.altnet.rippletest.net:51234
# XRPL_URL=
# XRPL_FAUCET_URL=https://faucet.altnet.rippletest.net/accounts

# Encrypted keys use the CLI's data directory by default. Keep a backup of this
# store and its passphrase; .deployment.json contains references, not seeds.
# Supply a passphrase via your environment/secret manager for unattended runs.
# XRPL_DATA_DIR=/absolute/path/to/private/xrpl-data
# XRPL_CONFIG_DIR=/absolute/path/to/private/xrpl-config
# XRPL_PASSPHRASE=
# TOKEN_STATE_FILE=/absolute/path/to/deployment.json
# TOKEN_PUBLIC_CONFIG=/absolute/path/to/web/public/deployment.json
# XRPL_BIN=/absolute/path/to/a/pinned/xrpl

# Token identity, encoded into MPTokenMetadata (XLS-89) at issuance time.
# TOKEN_TICKER should be uppercase letters/digits, max 6 characters recommended.
TOKEN_TICKER=SMPL
TOKEN_NAME="Simple Governance Token"
TOKEN_DESCRIPTION="A simple annually-issued governance token on the XRP Ledger."
TOKEN_ICON_URL=https://example.org/token-icon.png
TOKEN_ASSET_CLASS=other
TOKEN_ASSET_SUBCLASS=other
TOKEN_ISSUER_NAME="Example Issuer Co."

# Optional: comma-separated r-addresses to seed into the issuer/governance
# signer lists as-is (e.g. real GhostSig-controlled addresses), instead of
# the fully auto-generated placeholder wallets `setup-issuer`/
# `setup-governance` create by default. Any remaining signer slots are still
# auto-generated placeholders. Leave unset to keep today's fully-automatic
# local/CI behavior.
# ISSUER_SIGNER_ADDRESSES=
# GOVERNANCE_SIGNER_ADDRESSES=
